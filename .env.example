# --- Contact form "Let's connect" (`POST /api/contact`) ---
# Нужен хотя бы один канал: Telegram и/или Resend.

# Telegram: бот @BotFather → TELEGRAM_BOT_TOKEN; чат: твой user id или группа (часто через @userinfobot / getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend (https://resend.com): API key; письма на CONTACT_TO_EMAIL.
# CONTACT_FROM_EMAIL: домен должен быть верифицирован в Resend; для первых тестов часто используют onboarding@resend.dev
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev
